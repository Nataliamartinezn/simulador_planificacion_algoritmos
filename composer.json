{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "actividad/simulador-planificacion",
    "type": "project",
    "description": "Simulador parametrizable de algoritmos de planificación de procesos en Laravel.",
    "keywords": ["laravel", "scheduling", "fcfs", "sjf", "round-robin", "priority", "mlfq"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
